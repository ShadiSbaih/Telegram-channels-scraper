# ==========================================
# Telegram Channel Scraper - Git Ignore Rules
# ==========================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# PyInstaller / Compilation Outputs
build/
dist/
*.manifest
*.spec.bak

# Exports & User Data (Keep folder structure via .gitkeep)
exports/*
!exports/.gitkeep
downloads/*
!downloads/.gitkeep
*.csv
*.xlsx
*.json
!assets/*.json

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
*.log
*.tmp
*.bak

Design.md